  "validCases": [
    {
      "id": "rotated-wide-rated-image",
      "expression": "project/eagle type:image rating:>=4 width:>=1920 aspect:>=16/9",
      "oracle": [
        { "field": "tag", "operator": "all", "value": ["project/eagle"] },
        { "field": "type", "operator": "any", "value": ["image"] },
        { "field": "rating", "operator": "gte", "value": 4 },
        { "field": "width", "operator": "gte", "value": 1920 },
        {
          "field": "aspect",
          "operator": "gte",
          "value": { "numerator": 16, "denominator": 9 }
        }
      ],
      "expectedKeys": ["asset-a"]
    },
    {
      "id": "unknown-file-size",
      "expression": "size:unknown",
      "oracle": [
        { "field": "size", "operator": "is-unknown", "value": "unknown" }
      ],
      "expectedKeys": ["asset-b"]
    }
  ],
  "invalidCases": [
    {
      "id": "timezone-required",
      "expression": "modified:>=2026-08-19",
      "errorKind": "invalid-date",
      "offset": 0
    },
    {
      "id": "contradictory-width-range",
      "expression": "width:>1920 width:<1000",
      "errorKind": "conflicting-range",
      "offset": 12
    }
