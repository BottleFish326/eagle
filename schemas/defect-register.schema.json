{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://material-eagle.local/schemas/defect-register.schema.json",
  "title": "Material Eagle defect register",
  "description": "Explicit defect inventory reviewed at a stage exit. Draft registers cannot satisfy an acceptance gate.",
  "type": "object",
  "required": ["schema", "scope", "status", "reviewedAt", "findings"],
  "properties": {
    "schema": { "const": 1 },
    "scope": { "const": "phase-2-exit" },
    "status": { "enum": ["draft", "reviewed"] },
    "reviewedAt": {
      "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }]
    },
    "findings": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "draft" } } },
      "then": { "properties": { "reviewedAt": { "type": "null" } } },
      "else": { "properties": { "reviewedAt": { "type": "string" } } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "status",
        "summary",
        "evidence",
        "workaround",
        "targetVersion",
        "resolvedAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^DEF-[0-9]{4,}$" },
        "severity": { "enum": ["P0", "P1", "P2", "P3"] },
        "status": { "enum": ["open", "resolved"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "workaround": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 2000 }
          ]
        },
        "targetVersion": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 128 }
          ]
        },
        "resolvedAt": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
