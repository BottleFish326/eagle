{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://material-eagle.local/schemas/platform-matrix-evidence.schema.json",
  "title": "P2-A12 consolidated platform path evidence",
  "description": "Portable contract for the replayed GitHub-hosted darwin/linux/win32 path compatibility verdict.",
  "type": "object",
  "required": [
    "schema",
    "accepted",
    "failures",
    "verifiedAt",
    "gitCommit",
    "workflow",
    "verificationEnvironment",
    "artifacts"
  ],
  "properties": {
    "schema": { "const": 1 },
    "accepted": { "type": "boolean" },
    "failures": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "gitCommit": {
      "oneOf": [{ "$ref": "#/$defs/gitCommit" }, { "type": "null" }]
    },
    "workflow": { "$ref": "#/$defs/workflow" },
    "verificationEnvironment": {
      "oneOf": [
        { "$ref": "#/$defs/verificationEnvironment" },
        { "type": "null" }
      ]
    },
    "artifacts": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "accepted": { "const": true } }
      },
      "then": {
        "type": "object",
        "properties": {
          "failures": { "type": "array", "maxItems": 0 },
          "gitCommit": { "$ref": "#/$defs/gitCommit" },
          "workflow": { "$ref": "#/$defs/acceptedWorkflow" },
          "verificationEnvironment": {
            "$ref": "#/$defs/acceptedVerificationEnvironment"
          },
          "artifacts": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {
                "$ref": "#/$defs/acceptedDarwinArtifact"
              },
              {
                "$ref": "#/$defs/acceptedLinuxArtifact"
              },
              {
                "$ref": "#/$defs/acceptedWin32Artifact"
              }
            ],
            "items": false
          }
        }
      },
      "else": {
        "type": "object",
        "properties": { "failures": { "type": "array", "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "nullablePositiveIntegerString": {
      "oneOf": [
        { "type": "string", "pattern": "^[1-9][0-9]*$" },
        { "type": "null" }
      ]
    },
    "workflow": {
      "type": "object",
      "required": [
        "githubRunId",
        "githubRunAttempt",
        "githubWorkflowRef",
        "githubRepository",
        "githubServerUrl",
        "runUrl"
      ],
      "properties": {
        "githubRunId": { "$ref": "#/$defs/nullableString" },
        "githubRunAttempt": {
          "$ref": "#/$defs/nullablePositiveIntegerString"
        },
        "githubWorkflowRef": { "$ref": "#/$defs/nullableString" },
        "githubRepository": { "$ref": "#/$defs/nullableString" },
        "githubServerUrl": { "$ref": "#/$defs/nullableString" },
        "runUrl": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "acceptedWorkflow": {
      "type": "object",
      "required": [
        "githubRunId",
        "githubRunAttempt",
        "githubWorkflowRef",
        "githubRepository",
        "githubServerUrl",
        "runUrl"
      ],
      "properties": {
        "githubRunId": { "type": "string", "pattern": "^[0-9]+$" },
        "githubRunAttempt": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "githubWorkflowRef": {
          "type": "string",
          "pattern": "^.+/\\.github/workflows/ci\\.yml@.+$"
        },
        "githubRepository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "githubServerUrl": { "const": "https://github.com" },
        "runUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+/actions/runs/[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "verificationEnvironment": {
      "type": "object",
      "required": [
        "nodeVersion",
        "githubActions",
        "githubSha",
        "githubRunId",
        "githubRunAttempt",
        "githubWorkflowRef",
        "githubRepository",
        "githubServerUrl",
        "runnerOs",
        "runnerArch",
        "runnerEnvironment"
      ],
      "properties": {
        "nodeVersion": { "$ref": "#/$defs/nullableString" },
        "githubActions": { "$ref": "#/$defs/nullableString" },
        "githubSha": {
          "oneOf": [{ "$ref": "#/$defs/gitCommit" }, { "type": "null" }]
        },
        "githubRunId": { "$ref": "#/$defs/nullableString" },
        "githubRunAttempt": {
          "$ref": "#/$defs/nullablePositiveIntegerString"
        },
        "githubWorkflowRef": { "$ref": "#/$defs/nullableString" },
        "githubRepository": { "$ref": "#/$defs/nullableString" },
        "githubServerUrl": { "$ref": "#/$defs/nullableString" },
        "runnerOs": { "$ref": "#/$defs/nullableString" },
        "runnerArch": { "$ref": "#/$defs/nullableString" },
        "runnerEnvironment": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "acceptedVerificationEnvironment": {
      "type": "object",
      "required": [
        "nodeVersion",
        "githubActions",
        "githubSha",
        "githubRunId",
        "githubRunAttempt",
        "githubWorkflowRef",
        "githubRepository",
        "githubServerUrl",
        "runnerOs",
        "runnerArch",
        "runnerEnvironment"
      ],
      "properties": {
        "nodeVersion": { "type": "string", "pattern": "^v24\\." },
        "githubActions": { "const": "true" },
        "githubSha": { "$ref": "#/$defs/gitCommit" },
        "githubRunId": { "type": "string", "pattern": "^[0-9]+$" },
        "githubRunAttempt": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "githubWorkflowRef": {
          "type": "string",
          "pattern": "^.+/\\.github/workflows/ci\\.yml@.+$"
        },
        "githubRepository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "githubServerUrl": { "const": "https://github.com" },
        "runnerOs": { "const": "Linux" },
        "runnerArch": { "type": "string", "minLength": 1, "maxLength": 32 },
        "runnerEnvironment": { "const": "github-hosted" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifactName",
        "fileName",
        "sha256",
        "platform",
        "accepted",
        "startedAt",
        "completedAt",
        "environment",
        "expectedTests",
        "listedTests",
        "executedTests",
        "summary"
      ],
      "properties": {
        "artifactName": { "$ref": "#/$defs/nullableString" },
        "fileName": { "$ref": "#/$defs/nullableString" },
        "sha256": { "$ref": "#/$defs/nullableString" },
        "platform": { "$ref": "#/$defs/nullableString" },
        "accepted": { "type": "boolean" },
        "startedAt": { "$ref": "#/$defs/nullableString" },
        "completedAt": { "$ref": "#/$defs/nullableString" },
        "environment": { "$ref": "#/$defs/artifactEnvironment" },
        "expectedTests": { "$ref": "#/$defs/testNames" },
        "listedTests": { "$ref": "#/$defs/testNames" },
        "executedTests": { "$ref": "#/$defs/testNames" },
        "summary": {
          "oneOf": [{ "$ref": "#/$defs/summary" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "acceptedArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        {
          "type": "object",
          "properties": {
            "artifactName": {
              "type": "string",
              "pattern": "^p2-a12-source-(macOS|Linux|Windows)-[0-9a-f]{40,64}-attempt-[1-9][0-9]*$"
            },
            "fileName": { "const": "p2-a12-platform-paths.json" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "platform": { "enum": ["darwin", "linux", "win32"] },
            "accepted": { "const": true },
            "startedAt": { "type": "string", "format": "date-time" },
            "completedAt": { "type": "string", "format": "date-time" },
            "environment": {
              "$ref": "#/$defs/acceptedArtifactEnvironment"
            },
            "summary": { "$ref": "#/$defs/summary" }
          }
        }
      ]
    },
    "darwinTests": {
      "const": [
        "library::tests::p2_platform_rejects_configuration_that_enables_symlink_traversal",
        "library::tests::p2_platform_rejects_duplicate_and_overlapping_roots",
        "platform::tests::p2_platform_linux_keys_preserve_case_and_unicode_spelling",
        "platform::tests::p2_platform_macos_normalizes_unicode_without_assuming_volume_case_mode",
        "platform::tests::p2_platform_windows_keys_are_case_insensitive_and_unicode_normalized",
        "platform::tests::p2_platform_windows_portability_diagnostics_cover_names_characters_and_length",
        "scanner::tests::p2_platform_disconnect_during_scan_is_non_authoritative",
        "scanner::tests::p2_platform_permission_revocation_during_scan_is_non_authoritative",
        "scanner::tests::p2_platform_scans_native_unicode_path_without_rewriting_it",
        "scanner::tests::p2_platform_symlink_loop_is_skipped_once_with_an_explicit_diagnostic"
      ]
    },
    "linuxTests": {
      "const": [
        "library::tests::p2_platform_rejects_configuration_that_enables_symlink_traversal",
        "library::tests::p2_platform_rejects_duplicate_and_overlapping_roots",
        "platform::tests::p2_platform_linux_keys_preserve_case_and_unicode_spelling",
        "platform::tests::p2_platform_macos_normalizes_unicode_without_assuming_volume_case_mode",
        "platform::tests::p2_platform_windows_keys_are_case_insensitive_and_unicode_normalized",
        "platform::tests::p2_platform_windows_portability_diagnostics_cover_names_characters_and_length",
        "scanner::tests::p2_platform_disconnect_during_scan_is_non_authoritative",
        "scanner::tests::p2_platform_linux_moved_mount_root_is_non_authoritative",
        "scanner::tests::p2_platform_linux_scans_case_distinct_files_as_separate_assets",
        "scanner::tests::p2_platform_permission_revocation_during_scan_is_non_authoritative",
        "scanner::tests::p2_platform_scans_native_unicode_path_without_rewriting_it",
        "scanner::tests::p2_platform_symlink_loop_is_skipped_once_with_an_explicit_diagnostic"
      ]
    },
    "win32Tests": {
      "const": [
        "library::tests::p2_platform_rejects_configuration_that_enables_symlink_traversal",
        "library::tests::p2_platform_rejects_duplicate_and_overlapping_roots",
        "platform::tests::p2_platform_linux_keys_preserve_case_and_unicode_spelling",
        "platform::tests::p2_platform_macos_normalizes_unicode_without_assuming_volume_case_mode",
        "platform::tests::p2_platform_windows_keys_are_case_insensitive_and_unicode_normalized",
        "platform::tests::p2_platform_windows_portability_diagnostics_cover_names_characters_and_length",
        "scanner::tests::p2_platform_scans_native_unicode_path_without_rewriting_it",
        "scanner::tests::p2_platform_windows_long_path_scans_and_atomically_updates_sidecar",
        "scanner::tests::p2_platform_windows_symlink_loop_is_skipped_when_native_creation_is_available"
      ]
    },
    "acceptedDarwinArtifact": {
      "allOf": [
        { "$ref": "#/$defs/acceptedArtifact" },
        {
          "type": "object",
          "properties": {
            "artifactName": {
              "type": "string",
              "pattern": "^p2-a12-source-macOS-[0-9a-f]{40,64}-attempt-[1-9][0-9]*$"
            },
            "platform": { "const": "darwin" },
            "environment": {
              "allOf": [
                { "$ref": "#/$defs/acceptedArtifactEnvironment" },
                {
                  "type": "object",
                  "properties": { "runnerOs": { "const": "macOS" } }
                }
              ]
            },
            "expectedTests": { "$ref": "#/$defs/darwinTests" },
            "listedTests": { "$ref": "#/$defs/darwinTests" },
            "executedTests": { "$ref": "#/$defs/darwinTests" },
            "summary": {
              "allOf": [
                { "$ref": "#/$defs/summary" },
                {
                  "type": "object",
                  "properties": {
                    "result": { "const": "ok" },
                    "passed": { "const": 10 },
                    "failed": { "const": 0 },
                    "ignored": { "const": 0 },
                    "measured": { "const": 0 }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "acceptedLinuxArtifact": {
      "allOf": [
        { "$ref": "#/$defs/acceptedArtifact" },
        {
          "type": "object",
          "properties": {
            "artifactName": {
              "type": "string",
              "pattern": "^p2-a12-source-Linux-[0-9a-f]{40,64}-attempt-[1-9][0-9]*$"
            },
            "platform": { "const": "linux" },
            "environment": {
              "allOf": [
                { "$ref": "#/$defs/acceptedArtifactEnvironment" },
                {
                  "type": "object",
                  "properties": { "runnerOs": { "const": "Linux" } }
                }
              ]
            },
            "expectedTests": { "$ref": "#/$defs/linuxTests" },
            "listedTests": { "$ref": "#/$defs/linuxTests" },
            "executedTests": { "$ref": "#/$defs/linuxTests" },
            "summary": {
              "allOf": [
                { "$ref": "#/$defs/summary" },
                {
                  "type": "object",
                  "properties": {
                    "result": { "const": "ok" },
                    "passed": { "const": 12 },
                    "failed": { "const": 0 },
                    "ignored": { "const": 0 },
                    "measured": { "const": 0 }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "acceptedWin32Artifact": {
      "allOf": [
        { "$ref": "#/$defs/acceptedArtifact" },
        {
          "type": "object",
          "properties": {
            "artifactName": {
              "type": "string",
              "pattern": "^p2-a12-source-Windows-[0-9a-f]{40,64}-attempt-[1-9][0-9]*$"
            },
            "platform": { "const": "win32" },
            "environment": {
              "allOf": [
                { "$ref": "#/$defs/acceptedArtifactEnvironment" },
                {
                  "type": "object",
                  "properties": { "runnerOs": { "const": "Windows" } }
                }
              ]
            },
            "expectedTests": { "$ref": "#/$defs/win32Tests" },
            "listedTests": { "$ref": "#/$defs/win32Tests" },
            "executedTests": { "$ref": "#/$defs/win32Tests" },
            "summary": {
              "allOf": [
                { "$ref": "#/$defs/summary" },
                {
                  "type": "object",
                  "properties": {
                    "result": { "const": "ok" },
                    "passed": { "const": 9 },
                    "failed": { "const": 0 },
                    "ignored": { "const": 0 },
                    "measured": { "const": 0 }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "artifactEnvironment": {
      "type": "object",
      "required": [
        "architecture",
        "nodeVersion",
        "rustc",
        "cargo",
        "runnerOs",
        "runnerArch",
        "runnerEnvironment",
        "githubRunId",
        "githubRunAttempt",
        "githubWorkflowRef",
        "githubRepository",
        "githubServerUrl"
      ],
      "properties": {
        "architecture": { "$ref": "#/$defs/nullableString" },
        "nodeVersion": { "$ref": "#/$defs/nullableString" },
        "rustc": { "$ref": "#/$defs/nullableString" },
        "cargo": { "$ref": "#/$defs/nullableString" },
        "runnerOs": { "$ref": "#/$defs/nullableString" },
        "runnerArch": { "$ref": "#/$defs/nullableString" },
        "runnerEnvironment": { "$ref": "#/$defs/nullableString" },
        "githubRunId": { "$ref": "#/$defs/nullableString" },
        "githubRunAttempt": {
          "$ref": "#/$defs/nullablePositiveIntegerString"
        },
        "githubWorkflowRef": { "$ref": "#/$defs/nullableString" },
        "githubRepository": { "$ref": "#/$defs/nullableString" },
        "githubServerUrl": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "acceptedArtifactEnvironment": {
      "allOf": [
        { "$ref": "#/$defs/artifactEnvironment" },
        {
          "type": "object",
          "properties": {
            "architecture": { "type": "string", "minLength": 1 },
            "nodeVersion": { "type": "string", "pattern": "^v24\\." },
            "rustc": { "type": "string", "minLength": 1 },
            "cargo": { "type": "string", "minLength": 1 },
            "runnerOs": { "enum": ["macOS", "Linux", "Windows"] },
            "runnerArch": { "type": "string", "minLength": 1 },
            "runnerEnvironment": { "const": "github-hosted" },
            "githubRunId": { "type": "string", "pattern": "^[0-9]+$" },
            "githubRunAttempt": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "githubWorkflowRef": {
              "type": "string",
              "pattern": "^.+/\\.github/workflows/ci\\.yml@.+$"
            },
            "githubRepository": {
              "type": "string",
              "pattern": "^[^/\\s]+/[^/\\s]+$"
            },
            "githubServerUrl": { "const": "https://github.com" }
          }
        }
      ]
    },
    "testNames": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9_:]+$"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "result",
        "passed",
        "failed",
        "ignored",
        "measured",
        "filteredOut"
      ],
      "properties": {
        "result": { "enum": ["ok", "FAILED"] },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "ignored": { "type": "integer", "minimum": 0 },
        "measured": { "type": "integer", "minimum": 0 },
        "filteredOut": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
